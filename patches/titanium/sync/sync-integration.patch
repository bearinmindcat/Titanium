+  code_btns->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(2, 16), 8));
+  code_btns->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&ProfileMenuView::OnSelfHostSyncGenerateClicked,
+                          base::Unretained(this)),
+      u"Generate"));
+  code_btns->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&ProfileMenuView::OnSelfHostSyncCopyClicked,
+                          base::Unretained(this)),
+      u"Copy"));
+  code_btns->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&ProfileMenuView::OnSelfHostSyncCodeSaveClicked,
+                          base::Unretained(this)),
+      u"Save"));
+  content->AddChildView(std::move(code_btns));
+
+  // Per-type toggles: choose what syncs.
+  syncer::SyncUserSettings* settings =
+      sync_service ? sync_service->GetUserSettings() : nullptr;
+  const syncer::UserSelectableTypeSet selected =
+      settings ? settings->GetSelectedTypes() : syncer::UserSelectableTypeSet();
+  const struct {
+    syncer::UserSelectableType type;
+    const char16_t* label;
+  } kTypeRows[] = {
+      {syncer::UserSelectableType::kBookmarks, u"Bookmarks"},
+      {syncer::UserSelectableType::kHistory, u"History"},
+      {syncer::UserSelectableType::kPasswords, u"Passwords"},
+      {syncer::UserSelectableType::kAutofill, u"Autofill"},
+      {syncer::UserSelectableType::kExtensions, u"Extensions"},
+      {syncer::UserSelectableType::kTabs, u"Tabs"},
+      {syncer::UserSelectableType::kPreferences, u"Preferences"},
+  };
+  for (const auto& tr : kTypeRows) {
+    auto type_row = std::make_unique<views::View>();
+    type_row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(2, 16), 8));
+    type_row->AddChildView(std::make_unique<views::Label>(tr.label));
+    auto toggle = std::make_unique<views::ToggleButton>(base::BindRepeating(
+        &ProfileMenuView::OnSelfHostSyncTypesChanged, base::Unretained(this)));
+    // Focusable views require an accessible name (enforced by a paint DCHECK).
+    toggle->GetViewAccessibility().SetName(std::u16string(tr.label));
+    toggle->SetIsOn(selected.Has(tr.type));
+    selfhost_type_toggles_.emplace_back(
+        tr.type, type_row->AddChildView(std::move(toggle)));
+    content->AddChildView(std::move(type_row));
+  }
+
+  // Whole-profile export / import (bundles everything, including the saved
+  // sync server + code) to a single .zip.
+  auto io_btns = std::make_unique<views::View>();
+  io_btns->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(6, 16), 8));
+  io_btns->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&ProfileMenuView::OnSelfHostSyncExportClicked,
+                          base::Unretained(this)),
+      u"Export all"));
+  io_btns->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&ProfileMenuView::OnSelfHostSyncImportClicked,
+                          base::Unretained(this)),
+      u"Import all"));
+  content->AddChildView(std::move(io_btns));
+
+  selfhost_sync_content_ = content.get();
+  AddFeatureView(std::move(content));
+}
+
+void ProfileMenuView::OnSelfHostSyncExportClicked() {
+  SelfHostProfileTransfer::Start(SelfHostProfileTransfer::Mode::kExport,
+                                 profile().GetPath(),
+                                 browser().window()->GetNativeWindow());
+}
+
+void ProfileMenuView::OnSelfHostSyncImportClicked() {
+  SelfHostProfileTransfer::Start(SelfHostProfileTransfer::Mode::kImport,
+                                 profile().GetPath(),
+                                 browser().window()->GetNativeWindow());
+}
+
+void ProfileMenuView::OnSelfHostSyncToggleExpand() {
+  if (!selfhost_sync_content_) {
+    return;
+  }
+  selfhost_sync_content_->SetVisible(!selfhost_sync_content_->GetVisible());
+  // Grow/shrink the bubble to fit the now-visible (or hidden) panel.
+  SizeToContents();
+}
+
+void ProfileMenuView::OnSelfHostSyncTypesChanged() {
+  syncer::SyncService* sync_service =
+      SyncServiceFactory::GetForProfile(&profile());
+  if (!sync_service) {
+    return;
+  }
+  syncer::UserSelectableTypeSet types;
+  for (const auto& [type, toggle] : selfhost_type_toggles_) {
+    if (toggle && toggle->GetIsOn()) {
+      types.Put(type);
+    }
+  }
+  sync_service->GetUserSettings()->SetSelectedTypes(/*sync_everything=*/false,
+                                                    types);
+}
+
+void ProfileMenuView::OnSelfHostSyncSaveClicked() {
+  // Saves the self-hosted sync server address to prefs; the sync engine reads
+  // it on next launch (SyncServiceImpl constructor).
+  if (selfhost_server_textfield_) {
+    profile().GetPrefs()->SetString(
+        syncer::prefs::internal::kSelfHostSyncServerUrl,
+        base::UTF16ToUTF8(selfhost_server_textfield_->GetText()));
+  }
+}
+
+void ProfileMenuView::OnSelfHostSyncCodeSaveClicked() {
+  // Saves the sync code (BIP39 passphrase) to prefs; the sync engine derives
+  // the signing keys from it on next launch.
+  if (selfhost_code_textfield_) {
+    profile().GetPrefs()->SetString(
+        syncer::prefs::internal::kSelfHostSyncCode,
+        base::UTF16ToUTF8(selfhost_code_textfield_->GetText()));
+  }
+}
+
+void ProfileMenuView::OnSelfHostSyncGenerateClicked() {
+  // Fills the code field with a fresh random 24-word BIP39 sync code.
+  if (selfhost_code_textfield_) {
+    selfhost_code_textfield_->SetText(
+        base::UTF8ToUTF16(syncer::GenerateSelfHostSyncCode()));
+  }
+}
+
+void ProfileMenuView::OnSelfHostSyncCopyClicked() {
+  if (selfhost_code_textfield_) {
+    ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+        .WriteText(std::u16string(selfhost_code_textfield_->GetText()));
+  }
+}
