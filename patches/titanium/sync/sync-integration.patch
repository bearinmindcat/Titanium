 namespace {
 
+// Returns true for profile files that should go into an export archive.
+// Skips volatile caches / lock files so the .zip stays small and consistent.
+bool ShouldIncludeInProfileExport(const base::FilePath& path) {
+  static const char* const kSkip[] = {
+      "Cache",         "Code Cache",  "GPUCache",     "DawnCache",
+      "GraphiteDawnCache", "Service Worker", "Crashpad", "Singleton",
+      "component_crx_cache", "GrShaderCache", "ShaderCache"};
+  const std::string value = path.value();
+  for (const char* needle : kSkip) {
+    if (value.find(needle) != std::string::npos) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Zips the whole profile directory to `dest` (runs on a blocking thread).
+void DoProfileExport(const base::FilePath& profile_path,
+                     const base::FilePath& dest) {
+  zip::ZipWithFilterCallback(profile_path, dest,
+                             base::BindRepeating(&ShouldIncludeInProfileExport));
+}
+
+// Unzips `src` into a sibling "PendingImport" staging dir. A startup hook in
+// chrome_browser_main swaps it into place on next launch, since the live
+// profile's open database files can't be safely overwritten while running.
+void DoProfileImportStage(const base::FilePath& profile_path,
+                          const base::FilePath& src) {
+  const base::FilePath pending =
+      profile_path.DirName().Append(FILE_PATH_LITERAL("PendingImport"));
+  base::DeletePathRecursively(pending);
+  base::CreateDirectory(pending);
+  zip::Unzip(src, pending);
+}
+
+// Self-owned file-dialog driver for whole-profile export/import. Created on a
+// button click, deletes itself once the dialog resolves — so it outlives the
+// (ephemeral) profile bubble, which closes as soon as the dialog takes focus.
+class SelfHostProfileTransfer : public ui::SelectFileDialog::Listener {
+ public:
+  enum class Mode { kExport, kImport };
+
+  static void Start(Mode mode,
+                    const base::FilePath& profile_path,
+                    gfx::NativeWindow parent) {
+    new SelfHostProfileTransfer(mode, profile_path, parent);
+  }
+
+  SelfHostProfileTransfer(const SelfHostProfileTransfer&) = delete;
+  SelfHostProfileTransfer& operator=(const SelfHostProfileTransfer&) = delete;
+
+ private:
+  SelfHostProfileTransfer(Mode mode,
+                          const base::FilePath& profile_path,
+                          gfx::NativeWindow parent)
+      : mode_(mode), profile_path_(profile_path) {
+    select_file_dialog_ = ui::SelectFileDialog::Create(this, nullptr);
+    ui::SelectFileDialog::FileTypeInfo type_info;
+    type_info.extensions = {{FILE_PATH_LITERAL("zip")}};
+    type_info.include_all_files = true;
+    if (mode_ == Mode::kExport) {
+      select_file_dialog_->SelectFile(
+          ui::SelectFileDialog::SELECT_SAVEAS_FILE, std::u16string(),
+          profile_path_.DirName().Append(
+              FILE_PATH_LITERAL("chromium-profile.zip")),
+          &type_info, 1, FILE_PATH_LITERAL("zip"), parent);
+    } else {
+      select_file_dialog_->SelectFile(
+          ui::SelectFileDialog::SELECT_OPEN_FILE, std::u16string(),
+          profile_path_.DirName(), &type_info, 1, FILE_PATH_LITERAL("zip"),
+          parent);
+    }
+  }
+
+  ~SelfHostProfileTransfer() override {
+    if (select_file_dialog_) {
+      select_file_dialog_->ListenerDestroyed();
+    }
+  }
+
+  // ui::SelectFileDialog::Listener:
+  void FileSelected(const ui::SelectedFileInfo& file, int index) override {
+    const base::FilePath chosen = file.path();
+    if (mode_ == Mode::kExport) {
+      base::ThreadPool::PostTask(
+          FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+          base::BindOnce(&DoProfileExport, profile_path_, chosen));
+    } else {
+      // Stage the import, then restart so the swap can apply before any
+      // profile database is opened.
+      base::ThreadPool::PostTaskAndReply(
+          FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+          base::BindOnce(&DoProfileImportStage, profile_path_, chosen),
+          base::BindOnce(&chrome::AttemptRestart));
+    }
+    delete this;
+  }
+
+  void FileSelectionCanceled() override { delete this; }
+
+  Mode mode_;
+  base::FilePath profile_path_;
+  scoped_refptr<ui::SelectFileDialog> select_file_dialog_;
+};
