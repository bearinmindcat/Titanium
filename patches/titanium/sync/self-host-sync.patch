+
+class Profile;
+
+namespace settings {
+
+// Backs the account-less "Sync settings" section in chrome://settings:
+// status, sync-code generation, per-type toggles, and whole-profile
+// export/import (the operations that need to call into the browser process).
+class SelfHostSyncHandler : public content::WebUIMessageHandler,
+                            public ui::SelectFileDialog::Listener {
+ public:
+  explicit SelfHostSyncHandler(Profile* profile);
+
+  SelfHostSyncHandler(const SelfHostSyncHandler&) = delete;
+  SelfHostSyncHandler& operator=(const SelfHostSyncHandler&) = delete;
+
+  ~SelfHostSyncHandler() override;
+
