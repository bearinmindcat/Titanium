+
+/**
+ * @fileoverview
+ * 'settings-self-host-sync-page' is the top-level "Sync settings" section for
+ * account-less self-hosted sync. It hosts a main view (server, sync code,
+ * profile backup) and a "What to sync" sub-page.
+ */
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_link_row/cr_link_row.js';
+import 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+import 'chrome://resources/cr_elements/cr_view_manager/cr_view_manager.js';
+import '/shared/settings/prefs/prefs.js';
+import '../i18n_setup.js';
+import '../settings_page/settings_section.js';
+import '../settings_page/settings_subpage.js';
+import '../settings_shared.css.js';
+
+import type {CrToggleElement} from 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+import type {CrViewManagerElement} from 'chrome://resources/cr_elements/cr_view_manager/cr_view_manager.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {beforeNextRender, PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+
+import {routes} from '../route.js';
+import {RouteObserverMixin, Router} from '../router.js';
+import type {Route, SettingsRoutes} from '../router.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+import {SearchableViewContainerMixin} from '../settings_page/searchable_view_container_mixin.js';
+
+import {getTemplate} from './self_host_sync_page.html.js';
+
+const CODE_PREF = 'sync.selfhost_sync_code';
+const SERVER_PREF = 'sync.selfhost_server_url';
+
+interface TypeRow {
+  name: string;
+  label: string;
+  checked: boolean;
+}
+
+const TYPE_ROWS: Array<{name: string, label: string}> = [
+  {name: 'bookmarks', label: 'Bookmarks'},
+  {name: 'history', label: 'History'},
+  {name: 'passwords', label: 'Passwords'},
+  {name: 'autofill', label: 'Autofill'},
+  {name: 'extensions', label: 'Extensions'},
+  {name: 'tabs', label: 'Tabs'},
+  {name: 'preferences', label: 'Preferences'},
+];
+
+interface SelfHostSyncState {
+  online: boolean;
+  types: {[name: string]: boolean};
+}
+
+export interface SettingsSelfHostSyncPageElement {
+  $: {
+    viewManager: CrViewManagerElement,
+    server: HTMLInputElement,
+    code: HTMLTextAreaElement,
+  };
+}
+
+const SettingsSelfHostSyncPageElementBase =
+    SearchableViewContainerMixin(PrefsMixin(RouteObserverMixin(PolymerElement)));
+
+export class SettingsSelfHostSyncPageElement extends
+    SettingsSelfHostSyncPageElementBase implements SettingsPlugin {
+  static get is() {
+    return 'settings-self-host-sync-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      prefs: {type: Object, observer: 'populateFields_'},
+      routes_: {type: Object, value: () => routes},
+      statusText_: {type: String, value: '…'},
+      typeRows_: {
+        type: Array,
+        value: () => TYPE_ROWS.map(r => ({...r, checked: false})),
+      },
+      wordCount_: {type: Number, value: 0},
+    };
+  }
+
+  declare prefs: {[key: string]: any};
+  declare private routes_: SettingsRoutes;
+  declare private statusText_: string;
+  declare private typeRows_: TypeRow[];
+  declare private wordCount_: number;
+
+  override ready() {
+    super.ready();
+    this.populateFields_();
+  }
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.refreshState_();
+  }
+
+  override currentRouteChanged(newRoute: Route, oldRoute?: Route) {
+    super.currentRouteChanged(newRoute, oldRoute);
+    // Only the dedicated child route shows the "What to sync" sub-page; every
+    // other route that renders this element shows the main view.
+    queueMicrotask(async () => {
+      const viewId = newRoute === routes.SYNC_TYPES ? 'syncTypes' : 'main';
+      if (!this.$.viewManager.querySelector(`#${viewId}`)) {
+        // The sub-page view is stamped lazily; wait for it to render.
+        await this.beforeNextRenderPromise_();
+      }
+      if (this.$.viewManager.querySelector(`#${viewId}`)) {
+        this.$.viewManager.switchView(viewId, 'no-animation', 'no-animation');
+      }
+    });
+  }
+
+  private beforeNextRenderPromise_(): Promise<void> {
+    return new Promise(resolve => beforeNextRender(this, resolve));
+  }
+
+  private renderSyncTypes_(): boolean {
+    return this.inSearchMode || this.currentRoute === routes.SYNC_TYPES;
+  }
+
+  private onWhatToSyncClick_() {
+    Router.getInstance().navigateTo(routes.SYNC_TYPES);
+  }
+
+  // The server/code fields are plain <input>/<textarea>, so their values must
+  // be seeded from the prefs manually (runs on ready and whenever prefs load).
+  private populateFields_() {
+    const server =
+        this.shadowRoot?.querySelector<HTMLInputElement>('#server');
+    if (server) {
+      server.value = (this.get(`prefs.${SERVER_PREF}.value`) as string) || '';
+    }
+    // The sync-code box stays blank by default (like Brave's "Enter a sync
+    // code" dialog); the saved code is not shown back.
+    const code = this.shadowRoot?.querySelector<HTMLTextAreaElement>('#code');
+    if (code) {
+      code.value = '';
+    }
+  }
+
+  private refreshState_() {
+    sendWithPromise('getSelfHostSyncState').then(result => {
+      const state = result as SelfHostSyncState;
+      this.statusText_ = state.online ? 'ONLINE' : 'OFFLINE';
+      this.typeRows_ =
+          TYPE_ROWS.map(r => ({...r, checked: state.types[r.name] === true}));
+    });
+  }
+
+  private onServerChange_() {
+    this.setPrefValue(SERVER_PREF, this.$.server.value.trim());
+  }
+
+  private onCodeChange_() {
+    // Only persist a non-empty code, so leaving the (blank-by-default) box
+    // untouched never wipes a previously-saved code.
+    const value = this.$.code.value.trim();
+    if (value) {
+      this.setPrefValue(CODE_PREF, value);
+    }
+  }
+
+  private onCodeInput_() {
+    const words =
+        this.$.code.value.trim().split(/\s+/).filter(w => w.length > 0);
+    this.wordCount_ = words.length;
+  }
+
+  private onGenerateClick_() {
+    sendWithPromise('generateSelfHostSyncCode').then(result => {
+      const code = result as string;
+      this.setPrefValue(CODE_PREF, code);
+      this.$.code.value = code;
+      this.onCodeInput_();
+    });
+  }
+
+  private onCopyClick_() {
+    navigator.clipboard.writeText(this.$.code.value);
+  }
+
+  private onTypeToggle_(e: Event) {
+    const toggle = e.target as CrToggleElement;
+    const name = toggle.dataset['name'];
+    if (name) {
+      chrome.send('setSelfHostSyncType', [name, toggle.checked]);
+    }
+  }
+
+  private onExportClick_() {
+    chrome.send('exportSelfHostProfile');
+  }
+
+  private onImportClick_() {
+    chrome.send('importSelfHostProfile');
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-self-host-sync-page': SettingsSelfHostSyncPageElement;
+  }
+}
+
+customElements.define(
+    SettingsSelfHostSyncPageElement.is, SettingsSelfHostSyncPageElement);
