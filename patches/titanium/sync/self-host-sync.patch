+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/self_host_sync_handler.h"
+
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/lifetime/application_lifetime.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sync/sync_service_factory.h"
+#include "components/sync/base/user_selectable_type.h"
+#include "components/sync/service/self_host_sync_code.h"
+#include "components/sync/service/sync_service.h"
+#include "components/sync/service/sync_user_settings.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "third_party/zlib/google/zip.h"
+#include "ui/shell_dialogs/select_file_policy.h"
+#include "ui/shell_dialogs/selected_file_info.h"
+
+namespace settings {
+
+namespace {
+
+// The data types exposed as toggles, paired with the JS-side string ids.
+struct TypeRow {
+  const char* name;
+  syncer::UserSelectableType type;
+};
+
+constexpr TypeRow kTypeRows[] = {
+    {"bookmarks", syncer::UserSelectableType::kBookmarks},
+    {"history", syncer::UserSelectableType::kHistory},
+    {"passwords", syncer::UserSelectableType::kPasswords},
+    {"autofill", syncer::UserSelectableType::kAutofill},
+    {"extensions", syncer::UserSelectableType::kExtensions},
+    {"tabs", syncer::UserSelectableType::kTabs},
+    {"preferences", syncer::UserSelectableType::kPreferences},
+};
+
+std::optional<syncer::UserSelectableType> TypeFromName(const std::string& name) {
+  for (const auto& row : kTypeRows) {
+    if (name == row.name) {
+      return row.type;
+    }
+  }
+  return std::nullopt;
+}
+
+// Skips volatile caches / lock files so the export archive stays lean.
+bool ShouldIncludeInExport(const base::FilePath& path) {
+  static const char* const kSkip[] = {
+      "Cache",        "Code Cache",   "GPUCache",     "DawnCache",
+      "GraphiteDawnCache", "Service Worker", "Crashpad", "Singleton",
+      "component_crx_cache", "GrShaderCache", "ShaderCache"};
+  const std::string value = path.value();
+  for (const char* needle : kSkip) {
+    if (value.find(needle) != std::string::npos) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void DoExport(const base::FilePath& profile_path, const base::FilePath& dest) {
+  zip::ZipWithFilterCallback(profile_path, dest,
+                             base::BindRepeating(&ShouldIncludeInExport));
+}
+
+void DoImportStage(const base::FilePath& profile_path,
+                   const base::FilePath& src) {
+  const base::FilePath pending =
+      profile_path.DirName().Append(FILE_PATH_LITERAL("PendingImport"));
+  base::DeletePathRecursively(pending);
+  base::CreateDirectory(pending);
+  zip::Unzip(src, pending);
+}
+
+}  // namespace
+
+SelfHostSyncHandler::SelfHostSyncHandler(Profile* profile)
+    : profile_(profile) {}
+
+SelfHostSyncHandler::~SelfHostSyncHandler() {
+  if (select_file_dialog_) {
+    select_file_dialog_->ListenerDestroyed();
+  }
+}
+
+void SelfHostSyncHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getSelfHostSyncState",
+      base::BindRepeating(&SelfHostSyncHandler::HandleGetState,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "generateSelfHostSyncCode",
+      base::BindRepeating(&SelfHostSyncHandler::HandleGenerateCode,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setSelfHostSyncType",
+      base::BindRepeating(&SelfHostSyncHandler::HandleSetType,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "exportSelfHostProfile",
+      base::BindRepeating(&SelfHostSyncHandler::HandleExport,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "importSelfHostProfile",
+      base::BindRepeating(&SelfHostSyncHandler::HandleImport,
+                          base::Unretained(this)));
+}
+
+void SelfHostSyncHandler::HandleGetState(const base::ListValue& args) {
+  AllowJavascript();
+  const base::Value& callback_id = args[0];
+
+  syncer::SyncService* sync_service =
+      SyncServiceFactory::GetForProfile(profile_);
+  const bool online = sync_service && sync_service->IsSyncFeatureActive();
+
+  syncer::UserSelectableTypeSet selected;
+  if (sync_service) {
+    selected = sync_service->GetUserSettings()->GetSelectedTypes();
+  }
+
+  base::DictValue types;
+  for (const auto& row : kTypeRows) {
+    types.Set(row.name, selected.Has(row.type));
+  }
+
+  base::DictValue state;
+  state.Set("online", online);
+  state.Set("types", std::move(types));
+  ResolveJavascriptCallback(callback_id, base::Value(std::move(state)));
+}
+
+void SelfHostSyncHandler::HandleGenerateCode(const base::ListValue& args) {
+  AllowJavascript();
+  const base::Value& callback_id = args[0];
+  ResolveJavascriptCallback(
+      callback_id, base::Value(syncer::GenerateSelfHostSyncCode()));
+}
+
+void SelfHostSyncHandler::HandleSetType(const base::ListValue& args) {
+  if (args.size() < 2 || !args[0].is_string() || !args[1].is_bool()) {
+    return;
+  }
+  const std::optional<syncer::UserSelectableType> type =
+      TypeFromName(args[0].GetString());
+  if (!type) {
+    return;
+  }
+  syncer::SyncService* sync_service =
+      SyncServiceFactory::GetForProfile(profile_);
+  if (!sync_service) {
+    return;
+  }
+  syncer::SyncUserSettings* settings = sync_service->GetUserSettings();
+  syncer::UserSelectableTypeSet selected = settings->GetSelectedTypes();
+  if (args[1].GetBool()) {
+    selected.Put(*type);
+  } else {
+    selected.Remove(*type);
+  }
+  settings->SetSelectedTypes(/*sync_everything=*/false, selected);
+}
+
+void SelfHostSyncHandler::HandleExport(const base::ListValue& args) {
+  if (select_file_dialog_) {
+    return;  // A dialog is already open.
+  }
+  pending_is_export_ = true;
+  select_file_dialog_ = ui::SelectFileDialog::Create(this, nullptr);
+  ui::SelectFileDialog::FileTypeInfo type_info;
+  type_info.extensions = {{FILE_PATH_LITERAL("zip")}};
+  type_info.include_all_files = true;
+  select_file_dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_SAVEAS_FILE, std::u16string(),
+      profile_->GetPath().DirName().Append(
+          FILE_PATH_LITERAL("chromium-profile.zip")),
+      &type_info, 1, FILE_PATH_LITERAL("zip"),
+      web_ui()->GetWebContents()->GetTopLevelNativeWindow());
+}
+
+void SelfHostSyncHandler::HandleImport(const base::ListValue& args) {
+  if (select_file_dialog_) {
+    return;
+  }
+  pending_is_export_ = false;
+  select_file_dialog_ = ui::SelectFileDialog::Create(this, nullptr);
+  ui::SelectFileDialog::FileTypeInfo type_info;
+  type_info.extensions = {{FILE_PATH_LITERAL("zip")}};
+  type_info.include_all_files = true;
+  select_file_dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_OPEN_FILE, std::u16string(),
+      profile_->GetPath().DirName(), &type_info, 1, FILE_PATH_LITERAL("zip"),
+      web_ui()->GetWebContents()->GetTopLevelNativeWindow());
+}
+
+void SelfHostSyncHandler::FileSelected(const ui::SelectedFileInfo& file,
+                                       int index) {
+  const base::FilePath chosen = file.path();
+  const base::FilePath profile_path = profile_->GetPath();
+  select_file_dialog_ = nullptr;
+  if (pending_is_export_) {
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&DoExport, profile_path, chosen));
+  } else {
+    base::ThreadPool::PostTaskAndReply(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&DoImportStage, profile_path, chosen),
+        base::BindOnce(&chrome::AttemptRestart));
+  }
+}
+
+void SelfHostSyncHandler::FileSelectionCanceled() {
+  select_file_dialog_ = nullptr;
+}
+
+}  // namespace settings
